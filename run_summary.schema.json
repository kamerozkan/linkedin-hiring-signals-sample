{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hiring Signals run quality summary",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "status",
    "qualityError",
    "scans",
    "warnings",
    "companiesRequested",
    "companiesScanned",
    "jobsSeen"
  ],
  "properties": {
    "status": {
      "enum": [
        "SUCCEEDED",
        "SUCCEEDED_WITH_WARNINGS",
        "FAILED_QUALITY_GATE"
      ]
    },
    "qualityError": {
      "type": [
        "string",
        "null"
      ]
    },
    "companiesRequested": {
      "type": "integer"
    },
    "companiesScanned": {
      "type": "integer"
    },
    "jobsSeen": {
      "type": "integer"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scans": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "complete",
          "usable",
          "stopReason"
        ],
        "properties": {
          "complete": {
            "type": "boolean"
          },
          "usable": {
            "type": "boolean"
          },
          "stopReason": {
            "type": "string",
            "description": "Includes limit_reached for input caps and source_pagination_limit when LinkedIn rejects a later page with HTTP 400."
          }
        }
      }
    }
  }
}
